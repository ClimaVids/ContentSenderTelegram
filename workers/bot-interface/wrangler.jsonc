{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "climavids-content-sender-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ]
}
