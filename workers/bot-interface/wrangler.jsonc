{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "climavids-content-sender-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "exports": {
    "BotState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
